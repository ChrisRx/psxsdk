{
	"comment": "Prototype: exp/libps laid out as the resident library's image, a jump at each of its entry points and its variables at their addresses, for Net Yaroze programs to be combined with in place of Sony's.",
	"inherits": ["r3000"],
	"build-tags": ["yaroze", "golibps"],
	"cflags": ["-DLIBPS_GO"],
	"linkerscript": "targets/playstation-yaroze-image.ld",
	"ldflags": ["-Map=/sysroot/map.txt"],
	"extra-files": [
		"targets/playstation-yaroze-image.S",
		"targets/playstation-yaroze-image.c",
		"targets/playstation-yaroze-bios.S",
		"targets/playstation-yaroze-libps-gte.S",
		"targets/playstation-yaroze-gte.S",
		"targets/r3000-builtins.c",
		"targets/playstation-libc.c",
		"targets/playstation-yaroze-libps-data.c"
	]
}
