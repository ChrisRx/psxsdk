{
	"comment": "The MIPS R3000A as the PlayStation uses it: MIPS I, little endian, o32, no FPU and no MMU. Inherited by the playstation target, which adds the console.",
	"inheritable-only": true,
	"llvm-target": "mipsel-unknown-none",
	"cpu": "mips1",
	"features": "+mips1,+noabicalls,+soft-float",
	"build-tags": ["r3000", "baremetal"],
	"goos": "linux",
	"goarch": "mipsle",
	"linker": "ld.lld",
	"rtlib": "compiler-rt",
	"softfloat": true,
	"scheduler": "none",
	"gc": "leaking",
	"default-stack-size": 16384,
	"cflags": [
		"-march=mips1",
		"-msoft-float",
		"-mno-abicalls",
		"-fno-pic",
		"-G0",
		"-fno-exceptions",
		"-fno-unwind-tables",
		"-fno-asynchronous-unwind-tables",
		"-ffunction-sections",
		"-fdata-sections"
	],
	"ldflags": [
		"--gc-sections"
	],
	"extra-files": [
		"src/runtime/asm_mipsx.S"
	]
}
