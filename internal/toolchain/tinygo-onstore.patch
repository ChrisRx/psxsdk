+
+// Experiments returns the names of the compiler's experiments, in order.
+// A program built with -hot records which are on, and a patch for it has
+// to be built with the same (transform.HotExperiments).
+func Experiments() []string {
+	names := make([]string, 0, len(experiments))
+	for name := range experiments {
+		names = append(names, name)
+	}
+	slices.Sort(names)
+	return names
 }
 
