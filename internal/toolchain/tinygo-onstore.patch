+// Experiment reports whether the compiler's experiment called name is on:
+// as it is by default, unless -experiment names it, or names it after
+// "no" to turn it off.
+func (c *Config) Experiment(name string) bool {
+	on := experiments[name]
+	for _, e := range strings.Split(c.Options.Experiment, ",") {
+		switch strings.TrimSpace(e) {
+		case name:
+			on = true
+		case "no" + name:
+			on = false
+		}
+	}
+	return on
+}
