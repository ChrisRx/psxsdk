+// addCallPosition gives a call in a package outside the standard library
+// its position, as tinygo.pos metadata: the file, line and column, and the
+// package the call is in. The passes that report on a call
+// (transform.CheckKeeps and transform.CheckFrameAllocs) say where it is
+// from it when there is no DWARF: on the PlayStation targets, an R3000A,
+// whose compiler leaves it out. Every call createCall makes has the
+// position of the instruction it is made for, an allocation's call of
+// runtime.alloc among them. Metadata, unlike an attribute, does not keep
+// the optimizer from merging calls, so the code is what it would be
+// without.
+func (b *builder) addCallPosition(call llvm.Value, pos token.Pos) {
+	if b.Debug || b.CPU != "mips1" || !pos.IsValid() || b.fn == nil || b.fn.Pkg == nil {
+		return
+	}
+	path := b.fn.Pkg.Pkg.Path()
+	if first, _, _ := strings.Cut(path, "/"); path != "main" && !strings.Contains(first, ".") {
+		return
+	}
+	p := b.program.Fset.Position(pos)
+	i32 := b.ctx.Int32Type()
+	call.SetMetadata(b.ctx.MDKindID("tinygo.pos"), b.ctx.MDNode([]llvm.Metadata{
+		b.ctx.ConstString(p.Filename, false).ConstantAsMetadata(),
+		llvm.ConstInt(i32, uint64(p.Line), false).ConstantAsMetadata(),
+		llvm.ConstInt(i32, uint64(p.Column), false).ConstantAsMetadata(),
+		b.ctx.ConstString(path, false).ConstantAsMetadata(),
+	}))
+}
