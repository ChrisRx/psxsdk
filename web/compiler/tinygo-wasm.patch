@@ -0,0 +1,38 @@
+//go:build !wasm
+
+package loader
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"os/exec"
+
+	"github.com/tinygo-org/tinygo/compileopts"
+)
+
+// listPackages runs `go list` with the given extra arguments on pkgs and
+// returns what it printed: the JSON of each package, one after the other.
+// Standard library tests run it from wd, in the merged GOROOT, so that the
+// package there is the one found.
+func listPackages(config *compileopts.Config, extraArgs, pkgs []string, wd string) ([]byte, error) {
+	cmd, err := List(config, extraArgs, pkgs)
+	if err != nil {
+		return nil, err
+	}
+	if config.TestConfig.StandardPackage {
+		cmd.Dir = wd
+		cmd.Env = append(cmd.Env, "GOWORK=off")
+	}
+	buf := &bytes.Buffer{}
+	cmd.Stdout = buf
+	cmd.Stderr = os.Stderr
+	err = cmd.Run()
+	if err != nil {
+		if exitErr, ok := err.(*exec.ExitError); ok {
+			os.Exit(exitErr.ExitCode())
+		}
+		return nil, fmt.Errorf("failed to run `go list`: %s", err)
+	}
+	return buf.Bytes(), nil
+}
diff --git a/loader/list_wasm.go b/loader/list_wasm.go
new file mode 100644
index 0000000..c6df169
--- /dev/null
+++ b/loader/list_wasm.go
@@ -0,0 +1,499 @@
+//go:build wasm
+
+package loader
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"go/build"
+	"go/parser"
+	"go/token"
+	"io/fs"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/tinygo-org/tinygo/compileopts"
+	"github.com/tinygo-org/tinygo/goenv"
+	"golang.org/x/mod/modfile"
+	"golang.org/x/mod/module"
+)
+
+// listPackages does for a WebAssembly build of the compiler what running
+// `go list -json -deps -e` does elsewhere: it finds the packages named by
+// pkgs and everything they import, and returns the JSON `go list` would have
+// printed for them, dependencies first.
+//
+// There is no go command here, so the work it would do is done directly,
+// with go/build selecting each package's files for the target and the main
+// module's go.mod naming the modules it depends on. Those modules are found
+// in the module cache under GOMODCACHE (GOPATH/pkg/mod when unset), laid out
+// as the go command lays it out, or where a replace directive points.
+// Standard library packages come from GOROOT, which is the merged tree.
+//
+// The go command adds tags for its default experiments and the GOARCH
+// variant when it selects files; those are not knowable here, so the host
+// passes what `go list -f '{{context.ToolTags}}'` printed in GOTOOLTAGS.
+func listPackages(config *compileopts.Config, extraArgs, pkgs []string, wd string) ([]byte, error) {
+	if config.TestConfig.CompileTestBinary || config.TestConfig.StandardPackage {
+		return nil, errors.New("tests cannot be built by this build of the compiler")
+	}
+	goroot, err := GetCachedGoroot(config)
+	if err != nil {
+		return nil, err
+	}
+
+	ctx := build.Default
+	ctx.GOROOT = goroot
+	ctx.GOPATH = ""
+	ctx.GOOS = config.GOOS()
+	ctx.GOARCH = config.GOARCH()
+	ctx.CgoEnabled = true
+	ctx.Compiler = "gc"
+	ctx.BuildTags = config.BuildTags()
+	ctx.ToolTags = strings.Fields(os.Getenv("GOTOOLTAGS"))
+	ctx.ReleaseTags = nil
+	for i := 1; i <= config.GoMinorVersion; i++ {
+		ctx.ReleaseTags = append(ctx.ReleaseTags, "go"+strconv.Itoa(i))
+	}
+	ctx.Dir = wd
+
+	l := &lister{
+		ctx:      &ctx,
+		goroot:   goroot,
+		packages: make(map[string]*PackageJSON),
+	}
+	// The main module is the one holding the package named by a directory
+	// argument, or else the working directory.
+	moduleStart := wd
+	for _, arg := range pkgs {
+		if build.IsLocalImport(arg) || filepath.IsAbs(arg) {
+			moduleStart = arg
+			if !filepath.IsAbs(moduleStart) {
+				moduleStart = filepath.Join(wd, moduleStart)
+			}
+			break
+		}
+	}
+	if err := l.loadModules(filepath.Clean(moduleStart)); err != nil {
+		return nil, err
+	}
+
+	// Resolve the arguments: Go files, directories or import paths.
+	var roots []*PackageJSON
+	var files []string
+	for _, arg := range pkgs {
+		if strings.HasSuffix(arg, ".go") {
+			files = append(files, arg)
+			continue
+		}
+		pkg := l.loadArgument(arg, wd)
+		roots = append(roots, pkg)
+	}
+	if len(files) > 0 {
+		pkg, err := l.loadFiles(files, wd)
+		if err != nil {
+			return nil, err
+		}
+		roots = append(roots, pkg)
+	}
+
+	// Walk the dependencies, dependencies first, as `go list -deps` prints
+	// them. The go command adds the runtime to every program it links, so
+	// it is a dependency of every main package here too.
+	for _, root := range roots {
+		if root.Name == "main" && !hasString(root.Imports, "runtime") {
+			root.Imports = append(root.Imports, "runtime")
+			sort.Strings(root.Imports)
+		}
+		l.visit(root, nil)
+	}
+
+	buf := &bytes.Buffer{}
+	enc := json.NewEncoder(buf)
+	enc.SetIndent("", "\t")
+	for _, pkg := range l.sorted {
+		if err := enc.Encode(pkg); err != nil {
+			return nil, err
+		}
+	}
+	return buf.Bytes(), nil
+}
+
+// A lister resolves packages as the go command would, for one listing.
+type lister struct {
+	ctx      *build.Context
+	goroot   string
+	modules  []*moduleInfo // the main module first
+	packages map[string]*PackageJSON
+	sorted   []*PackageJSON
+}
+
+// A moduleInfo is a module the listing can take packages from, and where its
+// files are.
+type moduleInfo struct {
+	Path      string
+	Version   string
+	Dir       string
+	GoMod     string
+	GoVersion string
+	Main      bool
+}
+
+// loadModules finds the main module's go.mod from wd upwards and works out
+// where each module it requires lives.
+func (l *lister) loadModules(wd string) error {
+	dir := wd
+	var gomod string
+	for {
+		candidate := filepath.Join(dir, "go.mod")
+		if _, err := os.Stat(candidate); err == nil {
+			gomod = candidate
+			break
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			return errors.New("go.mod file not found in current directory or any parent directory")
+		}
+		dir = parent
+	}
+	data, err := os.ReadFile(gomod)
+	if err != nil {
+		return err
+	}
+	f, err := modfile.Parse(gomod, data, nil)
+	if err != nil {
+		return err
+	}
+	if f.Module == nil {
+		return fmt.Errorf("%s: no module directive", gomod)
+	}
+	main := &moduleInfo{
+		Path:  f.Module.Mod.Path,
+		Dir:   dir,
+		GoMod: gomod,
+		Main:  true,
+	}
+	if f.Go != nil {
+		main.GoVersion = f.Go.Version
+	}
+	l.modules = append(l.modules, main)
+
+	modcache := os.Getenv("GOMODCACHE")
+	if modcache == "" {
+		modcache = filepath.Join(goenv.Get("GOPATH"), "pkg", "mod")
+	}
+	replaced := make(map[module.Version]module.Version)
+	for _, r := range f.Replace {
+		replaced[r.Old] = r.New
+	}
+	for _, r := range f.Require {
+		m := &moduleInfo{Path: r.Mod.Path, Version: r.Mod.Version}
+		target := r.Mod
+		if new, ok := replaced[r.Mod]; ok {
+			target = new
+		} else if new, ok := replaced[module.Version{Path: r.Mod.Path}]; ok {
+			target = new
+		}
+		if target.Version == "" {
+			// A replacement by a directory, relative to the main module.
+			m.Dir = target.Path
+			if !filepath.IsAbs(m.Dir) {
+				m.Dir = filepath.Join(dir, m.Dir)
+			}
+		} else {
+			escaped, err := module.EscapePath(target.Path)
+			if err != nil {
+				return err
+			}
+			m.Dir = filepath.Join(modcache, escaped+"@"+target.Version)
+		}
+		m.GoMod = filepath.Join(m.Dir, "go.mod")
+		l.modules = append(l.modules, m)
+	}
+	return nil
+}
+
+// moduleFor returns the module whose path is the longest prefix of
+// importPath, and the directory of the package within it.
+func (l *lister) moduleFor(importPath string) (*moduleInfo, string) {
+	var best *moduleInfo
+	for _, m := range l.modules {
+		if importPath == m.Path || strings.HasPrefix(importPath, m.Path+"/") {
+			if best == nil || len(m.Path) > len(best.Path) {
+				best = m
+			}
+		}
+	}
+	if best == nil {
+		return nil, ""
+	}
+	return best, filepath.Join(best.Dir, filepath.FromSlash(strings.TrimPrefix(importPath, best.Path)))
+}
+
+// loadArgument resolves a command line argument: a directory, relative to wd
+// or absolute, or an import path.
+func (l *lister) loadArgument(arg, wd string) *PackageJSON {
+	if build.IsLocalImport(arg) || filepath.IsAbs(arg) {
+		dir := arg
+		if !filepath.IsAbs(dir) {
+			dir = filepath.Join(wd, dir)
+		}
+		dir = filepath.Clean(dir)
+		main := l.modules[0]
+		rel, err := filepath.Rel(main.Dir, dir)
+		if err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+			return &PackageJSON{
+				ImportPath: "command-line-arguments",
+				Dir:        dir,
+				Error:      listError(fmt.Sprintf("directory %s outside main module %s", dir, main.Path)),
+			}
+		}
+		importPath := main.Path
+		if rel != "." {
+			importPath = path.Join(main.Path, filepath.ToSlash(rel))
+		}
+		return l.loadDir(importPath, dir, main)
+	}
+	return l.resolve(arg, wd)
+}
+
+// loadFiles makes the package `go list` calls command-line-arguments out of
+// Go files named on the command line, which all have to be in one directory.
+func (l *lister) loadFiles(files []string, wd string) (*PackageJSON, error) {
+	dir := ""
+	for i, f := range files {
+		if !filepath.IsAbs(f) {
+			f = filepath.Join(wd, f)
+		}
+		files[i] = f
+		if dir == "" {
+			dir = filepath.Dir(f)
+		} else if filepath.Dir(f) != dir {
+			return nil, errors.New("named files must all be in one directory")
+		}
+	}
+	pkg := &PackageJSON{ImportPath: "command-line-arguments", Dir: dir}
+	l.setModule(pkg, l.modules[0])
+	imports := make(map[string]bool)
+	fset := token.NewFileSet()
+	for _, f := range files {
+		parsed, err := parser.ParseFile(fset, f, nil, parser.ImportsOnly)
+		if err != nil {
+			return nil, err
+		}
+		pkg.Name = parsed.Name.Name
+		cgo := false
+		for _, imp := range parsed.Imports {
+			p, _ := strconv.Unquote(imp.Path.Value)
+			imports[p] = true
+			if p == "C" {
+				cgo = true
+			}
+		}
+		if cgo {
+			pkg.CgoFiles = append(pkg.CgoFiles, filepath.Base(f))
+		} else {
+			pkg.GoFiles = append(pkg.GoFiles, filepath.Base(f))
+		}
+	}
+	pkg.Imports = sortedKeys(imports)
+	addCgoImports(pkg)
+	return pkg, nil
+}
+
+// loadDir reads the package in dir, which belongs to module m under
+// importPath.
+func (l *lister) loadDir(importPath, dir string, m *moduleInfo) *PackageJSON {
+	bp, err := l.ctx.ImportDir(dir, 0)
+	pkg := l.fromBuild(importPath, bp, err)
+	l.setModule(pkg, m)
+	pkg.Root = m.Dir
+	return pkg
+}
+
+// resolve finds the package importPath names when imported from fromDir: in
+// one of the modules, or else in the standard library.
+func (l *lister) resolve(importPath, fromDir string) *PackageJSON {
+	if m, dir := l.moduleFor(importPath); m != nil {
+		return l.loadDir(importPath, dir, m)
+	}
+	bp, err := l.ctx.Import(importPath, fromDir, 0)
+	resolved := importPath
+	if bp != nil && bp.ImportPath != "" {
+		// A package vendored into the standard library is listed under the
+		// path it was found at.
+		resolved = bp.ImportPath
+	}
+	pkg := l.fromBuild(resolved, bp, err)
+	if bp != nil && bp.Goroot {
+		pkg.Standard = true
+		pkg.Root = l.goroot
+	}
+	return pkg
+}
+
+// fromBuild makes the listing of a package from what go/build read of it.
+func (l *lister) fromBuild(importPath string, bp *build.Package, err error) *PackageJSON {
+	pkg := &PackageJSON{ImportPath: importPath}
+	if bp != nil {
+		pkg.Dir = bp.Dir
+		pkg.Name = bp.Name
+		pkg.GoFiles = bp.GoFiles
+		pkg.CgoFiles = bp.CgoFiles
+		pkg.CFiles = bp.CFiles
+		pkg.Imports = bp.Imports
+		pkg.EmbedFiles = resolveEmbeds(bp.Dir, bp.EmbedPatterns)
+	}
+	if err != nil {
+		var noGo *build.NoGoError
+		if errors.As(err, &noGo) && bp != nil && bp.Name != "" {
+			// Only files excluded by build constraints: not an error for a
+			// listing, as the package may still have what it needs.
+		} else {
+			pkg.Error = listError(err.Error())
+		}
+	}
+	if importPath == "unsafe" {
+		pkg.Name = "unsafe"
+		pkg.Error = nil
+	}
+	addCgoImports(pkg)
+	return pkg
+}
+
+// setModule records which module pkg came from.
+func (l *lister) setModule(pkg *PackageJSON, m *moduleInfo) {
+	pkg.Module.Path = m.Path
+	pkg.Module.Main = m.Main
+	pkg.Module.Dir = m.Dir
+	pkg.Module.GoMod = m.GoMod
+	pkg.Module.GoVersion = m.GoVersion
+	pkg.Module.Version = m.Version
+}
+
+// visit adds pkg and, before it, everything it imports to the listing. The
+// stack is the chain of imports that led here, for error reports.
+func (l *lister) visit(pkg *PackageJSON, stack []string) {
+	if _, ok := l.packages[pkg.ImportPath]; ok {
+		return
+	}
+	l.packages[pkg.ImportPath] = pkg
+	stack = append(stack, pkg.ImportPath)
+	if pkg.Error != nil {
+		pkg.Error.ImportStack = append([]string(nil), stack...)
+	} else {
+		for i, imp := range pkg.Imports {
+			if imp == "C" {
+				continue
+			}
+			dep, ok := l.packages[imp]
+			if !ok {
+				dep = l.resolve(imp, pkg.Dir)
+				if dep.ImportPath != imp {
+					if pkg.ImportMap == nil {
+						pkg.ImportMap = make(map[string]string)
+					}
+					pkg.ImportMap[imp] = dep.ImportPath
+					pkg.Imports[i] = dep.ImportPath
+				}
+				l.visit(dep, stack)
+			}
+		}
+	}
+	l.sorted = append(l.sorted, pkg)
+}
+
+// addCgoImports adds the imports the go command gives a package that uses
+// cgo.
+func addCgoImports(pkg *PackageJSON) {
+	if len(pkg.CgoFiles) == 0 {
+		return
+	}
+	for _, imp := range []string{"runtime", "syscall", "unsafe"} {
+		if !hasString(pkg.Imports, imp) {
+			pkg.Imports = append(pkg.Imports, imp)
+		}
+	}
+	sort.Strings(pkg.Imports)
+}
+
+// resolveEmbeds lists the files the //go:embed patterns of a package in dir
+// match, relative to dir, as `go list` reports them in EmbedFiles. A pattern
+// matching a directory takes every file under it except those whose names
+// start with . or _.
+func resolveEmbeds(dir string, patterns []string) []string {
+	if len(patterns) == 0 {
+		return nil
+	}
+	files := make(map[string]bool)
+	for _, pattern := range patterns {
+		pattern = strings.TrimPrefix(pattern, "all:")
+		matches, err := fs.Glob(os.DirFS(dir), pattern)
+		if err != nil {
+			continue
+		}
+		for _, match := range matches {
+			info, err := os.Stat(filepath.Join(dir, match))
+			if err != nil {
+				continue
+			}
+			if !info.IsDir() {
+				files[match] = true
+				continue
+			}
+			fs.WalkDir(os.DirFS(dir), match, func(p string, d fs.DirEntry, err error) error {
+				if err != nil {
+					return nil
+				}
+				name := d.Name()
+				if p != match && (strings.HasPrefix(name, ".") || strings.HasPrefix(name, "_")) {
+					if d.IsDir() {
+						return fs.SkipDir
+					}
+					return nil
+				}
+				if !d.IsDir() {
+					files[p] = true
+				}
+				return nil
+			})
+		}
+	}
+	return sortedKeys(files)
+}
+
+func listError(msg string) *struct {
+	ImportStack []string
+	Pos         string
+	Err         string
+} {
+	return &struct {
+		ImportStack []string
+		Pos         string
+		Err         string
+	}{Err: msg}
+}
+
+func hasString(list []string, s string) bool {
+	for _, x := range list {
+		if x == s {
+			return true
+		}
+	}
+	return false
+}
+
+func sortedKeys(m map[string]bool) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
