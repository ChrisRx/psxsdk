+//go:build !wasm
+
+package loader
+
+import "github.com/tinygo-org/tinygo/compileopts"
+
+// GetCachedGoroot returns a GOROOT holding the standard library with TinyGo's
+// changes merged in, creating it under the cache directory if needed.
+func GetCachedGoroot(config *compileopts.Config) (string, error) {
+	return mergeGoroot(config)
+}
