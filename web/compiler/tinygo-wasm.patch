+//go:build tinygo.wasm && custommalloc
+
+package runtime
+
+import "unsafe"
+
+// tinygo_morecore gives the C library's allocator a piece of this heap:
+// a manual allocation, which the collector neither scans nor frees, that
+// the allocator carves up for C and never returns. The library's sbrk
+// calls it instead of growing the module's memory, which this heap takes
+// to be its own.
+//
+//export tinygo_morecore
+func tinygo_morecore(size uintptr) unsafe.Pointer {
+	if size == 0 {
+		return nil
+	}
+	return allocManual(size)
+}
