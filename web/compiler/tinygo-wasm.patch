@@ -0,0 +1,14 @@
+//go:build wasm
+
+package builder
+
+import "golang.org/x/tools/go/ssa"
+
+// buildSSAProgram builds the SSA of every package one after another: the
+// WebAssembly build of the compiler has no scheduler to run the goroutines
+// Program.Build would start.
+func buildSSAProgram(program *ssa.Program) {
+	for _, pkg := range program.AllPackages() {
+		pkg.Build()
+	}
+}
