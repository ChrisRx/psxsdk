new file mode 100644
index 0000000..d3624d3
--- /dev/null
+++ b/builder/tools_wasm.go
@@ -0,0 +1,40 @@
+//go:build wasm
+
+package builder
+
+import (
+	"errors"
+	"fmt"
+)
+
+// runCCompiler invokes the C compiler with the given arguments, in-process,
+// since a WebAssembly build of the compiler cannot start processes. The
+// build that ships leaves clang out, which is half of its size, and relies
+// on its cache instead: the host fills the cache with the full build before
+// shipping, so the C and assembly files the targets need are already
+// compiled. Reaching clang there means a file is not.
+func runCCompiler(flags ...string) error {
+	if !hasBuiltinTools {
+		return errors.New("this build of the compiler has no C compiler")
+	}
+	if err := RunTool("clang", flags...); err != nil {
+		return errors.New("this build of the compiler cannot compile C or assembly, and the file is not in its cache")
+	}
+	return nil
+}
+
+// link invokes the linker with the given flags, in-process like the C
+// compiler. The environment is not needed: there is no process to pass it
+// to, and the in-process linker does not read it.
+func link(linker string, flags []string, env ...string) error {
+	if linker != "ld.lld" && linker != "wasm-ld" {
+		return fmt.Errorf("unexpected: linker %s should be ld.lld or wasm-ld", linker)
+	}
+	if !hasBuiltinTools {
+		return errors.New("this build of the compiler has no linker")
+	}
+	if err := RunTool(linker, flags...); err != nil {
+		return LinkerError{"failed to link: " + err.Error()}
+	}
+	return nil
+}
