@@ -0,0 +1,20 @@
+//go:build wasm
+
+package builder
+
+import (
+	"os"
+
+	"github.com/tinygo-org/tinygo/goenv"
+)
+
+// ReadBuildID returns the build ID of the compiler, which tells its cache
+// entries apart from those of other builds of it. A WebAssembly build cannot
+// read its own module, so the host names it in TINYGO_BUILD_ID, and failing
+// that it is the TinyGo version.
+func ReadBuildID() ([]byte, error) {
+	if id := os.Getenv("TINYGO_BUILD_ID"); id != "" {
+		return []byte(id), nil
+	}
+	return []byte("tinygo-wasm " + goenv.Version()), nil
+}
