@@ -0,0 +1,25 @@
+//go:build !wasm
+
+package builder
+
+import (
+	"fmt"
+	"runtime"
+
+	"github.com/tinygo-org/tinygo/goenv"
+)
+
+// checkBuildToolchain checks that the Go toolchain version isn't newer than
+// the one TinyGo was compiled with.
+// This may be a bit too aggressive: if the newer version doesn't change the
+// Go language we will most likely be able to compile it.
+func checkBuildToolchain(gorootMajor, gorootMinor int) error {
+	buildMajor, buildMinor, _, err := goenv.Parse(runtime.Version())
+	if err != nil {
+		return err
+	}
+	if buildMajor != 1 || buildMinor < gorootMinor {
+		return fmt.Errorf("cannot compile with Go toolchain version go%d.%d (TinyGo was built using toolchain version %s)", gorootMajor, gorootMinor, runtime.Version())
+	}
+	return nil
+}
