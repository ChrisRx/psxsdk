+++ b/src/internal/poll/park_wasip1_nosched.go
@@ -0,0 +1,15 @@
+//go:build wasip1 && scheduler.none
+
+package poll
+
+import "time"
+
+// parkUntil cannot wait for the file: without a scheduler there is no
+// goroutine to park, and nothing that would wake it. The caller gets the
+// deadline error and tries again as it sees fit.
+func (fd *FD) parkUntil(mode uint8, deadline time.Time) error {
+	return ErrDeadlineExceeded
+}
+
+// wait cannot park either: the caller tries again.
+func wait(fd int, mode uint8) {}
