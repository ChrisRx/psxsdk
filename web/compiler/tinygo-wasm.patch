--- /dev/null
+++ b/loader/goroot_wasm.go
@@ -0,0 +1,28 @@
+//go:build wasm
+
+package loader
+
+import (
+	"errors"
+	"os"
+
+	"github.com/tinygo-org/tinygo/compileopts"
+	"github.com/tinygo-org/tinygo/goenv"
+)
+
+// GetCachedGoroot returns the GOROOT the compiler was started with, which for
+// a WebAssembly build already has TinyGo's changes merged in: the host
+// prepares the tree, since this build has no symlinks to merge one with. The
+// tinygo-sysroot command writes such a tree.
+func GetCachedGoroot(config *compileopts.Config) (string, error) {
+	goroot := goenv.Get("GOROOT")
+	if goroot == "" {
+		return "", errors.New("could not determine GOROOT")
+	}
+	// Merging would have made the cache directory; the compiled packages
+	// written there later expect it to exist.
+	if err := os.MkdirAll(goenv.Get("GOCACHE"), 0o777); err != nil {
+		return "", err
+	}
+	return goroot, nil
+}
