+//go:build tinygo.wasm && custommalloc
+
+package runtime
+
+import "unsafe"
+
+//go:extern __heap_end
+var initialMemoryEnd [0]byte
+
+// heapStartAddr is where the heap begins: at the end of the memory the
+// module starts with. The C library's allocator takes what lies between
+// the globals and there for itself before it asks for more (see
+// tinygo_morecore), so this heap, which grows the memory, starts past it.
+func heapStartAddr() uintptr {
+	return uintptr(unsafe.Pointer(&initialMemoryEnd))
+}
