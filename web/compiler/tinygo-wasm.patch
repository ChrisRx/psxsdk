@@ -0,0 +1,21 @@
+package builder
+
+import (
+	"fmt"
+	"os"
+	"time"
+)
+
+// timingOn reports stage timings on stderr when TINYGO_TIMING is set.
+var timingOn = os.Getenv("TINYGO_TIMING") != ""
+
+var timingStart = time.Now()
+
+// stage prints how long the stage named took, and the time since the
+// build started.
+func stage(name string, start time.Time) {
+	if !timingOn {
+		return
+	}
+	fmt.Fprintf(os.Stderr, "timing: %-40s %7.0f ms  (at %5.0f ms)\n", name, float64(time.Since(start).Microseconds())/1000, float64(time.Since(timingStart).Microseconds())/1000)
+}
