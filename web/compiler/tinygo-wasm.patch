diff --git a/cmd/tinygo-sysroot/main.go b/cmd/tinygo-sysroot/main.go
new file mode 100644
index 0000000..8aed415
--- /dev/null
+++ b/cmd/tinygo-sysroot/main.go
@@ -0,0 +1,315 @@
+// Command tinygo-sysroot gathers everything a WebAssembly build of the TinyGo
+// compiler (cmd/tinygo-wasm) reads while building programs for one target,
+// into a directory tree that a host can hand it as its file system:
+//
+//	tinygo-sysroot -target=playstation-yaroze -o sysroot ./examples/...
+//
+// The tree holds, under goroot/, the standard library packages the named
+// programs and their dependencies use, from the GOROOT merged with TinyGo's
+// changes, with only the files the target selects; under mod/<module>/, the
+// packages of every other module they use; under tinygo/, the target
+// definitions and the C headers the compiler needs; and in env.json, the
+// environment the compiler has to be started with.
+//
+// It runs where the go command and this TinyGo's native build are, since it
+// asks them what the compiler in the browser cannot.
+package main
+
+import (
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/tinygo-org/tinygo/builder"
+	"github.com/tinygo-org/tinygo/compileopts"
+	"github.com/tinygo-org/tinygo/goenv"
+	"github.com/tinygo-org/tinygo/loader"
+)
+
+// listedPackage is what `go list -json` reports of a package, the fields
+// that name files to copy.
+type listedPackage struct {
+	Dir        string
+	ImportPath string
+	Name       string
+	Standard   bool
+	Module     *struct {
+		Path  string
+		Main  bool
+		Dir   string
+		GoMod string
+	}
+	GoFiles        []string
+	CgoFiles       []string
+	CFiles         []string
+	HFiles         []string
+	SFiles         []string
+	EmbedFiles     []string
+	IgnoredGoFiles []string
+	Error          *struct{ Err string }
+}
+
+// environment is written to env.json: what the wasm compiler needs in its
+// environment, with paths relative to the sysroot's root.
+type environment struct {
+	GOROOT     string `json:"GOROOT"`
+	GOVERSION  string `json:"GOVERSION"`
+	GOTOOLTAGS string `json:"GOTOOLTAGS"`
+	TINYGOROOT string `json:"TINYGOROOT"`
+	GOMODCACHE string `json:"GOMODCACHE"`
+	Target     string `json:"target"`
+	Modules    []struct {
+		Path string `json:"path"`
+		Dir  string `json:"dir"`
+	} `json:"modules"`
+}
+
+func main() {
+	target := flag.String("target", "", "target the programs are built for")
+	out := flag.String("o", "", "directory to write the sysroot into")
+	tags := flag.String("tags", "", "a space-separated list of extra build tags")
+	flag.Parse()
+	if *target == "" || *out == "" || flag.NArg() == 0 {
+		fmt.Fprintln(os.Stderr, "usage: tinygo-sysroot -target=TARGET -o DIR PACKAGES...")
+		os.Exit(2)
+	}
+	if err := run(*target, *out, strings.Fields(*tags), flag.Args()); err != nil {
+		fmt.Fprintln(os.Stderr, "error:", err)
+		os.Exit(1)
+	}
+}
+
+func run(target, out string, tags, patterns []string) error {
+	config, err := builder.NewConfig(&compileopts.Options{
+		GOOS:   goenv.Get("GOOS"),
+		GOARCH: goenv.Get("GOARCH"),
+		GOARM:  goenv.Get("GOARM"),
+		GOMIPS: goenv.Get("GOMIPS"),
+		Target: target,
+		Tags:   tags,
+	})
+	if err != nil {
+		return err
+	}
+
+	// Ask the go command for the packages, as the compiler's loader does.
+	cmd, err := loader.List(config, []string{"-json", "-deps", "-e"}, patterns)
+	if err != nil {
+		return err
+	}
+	cmd.Stderr = os.Stderr
+	output, err := cmd.Output()
+	if err != nil {
+		return fmt.Errorf("go list: %w", err)
+	}
+	var packages []*listedPackage
+	decoder := json.NewDecoder(strings.NewReader(string(output)))
+	for {
+		pkg := &listedPackage{}
+		if err := decoder.Decode(pkg); err == io.EOF {
+			break
+		} else if err != nil {
+			return err
+		}
+		if pkg.Error != nil {
+			return fmt.Errorf("%s: %s", pkg.ImportPath, pkg.Error.Err)
+		}
+		packages = append(packages, pkg)
+	}
+
+	env := environment{
+		GOROOT:     "goroot",
+		TINYGOROOT: "tinygo",
+		GOMODCACHE: "modcache",
+		Target:     target,
+	}
+	env.GOVERSION, err = goenv.GorootVersionString()
+	if err != nil {
+		return err
+	}
+	env.GOTOOLTAGS, err = toolTags(config)
+	if err != nil {
+		return err
+	}
+
+	modules := make(map[string]string) // module path -> directory in the sysroot
+	for _, pkg := range packages {
+		var dst string
+		switch {
+		case pkg.Standard:
+			dst = filepath.Join(out, "goroot", "src", filepath.FromSlash(pkg.ImportPath))
+		case pkg.Module != nil:
+			moddir := filepath.Join("mod", filepath.FromSlash(pkg.Module.Path))
+			modules[pkg.Module.Path] = moddir
+			rel, err := filepath.Rel(pkg.Module.Dir, pkg.Dir)
+			if err != nil {
+				return err
+			}
+			dst = filepath.Join(out, moddir, rel)
+			if err := copyFile(pkg.Module.GoMod, filepath.Join(out, moddir, "go.mod")); err != nil {
+				return err
+			}
+		default:
+			return fmt.Errorf("%s: neither standard nor in a module", pkg.ImportPath)
+		}
+		var files []string
+		files = append(files, pkg.GoFiles...)
+		files = append(files, pkg.CgoFiles...)
+		files = append(files, pkg.CFiles...)
+		files = append(files, pkg.HFiles...)
+		files = append(files, pkg.SFiles...)
+		files = append(files, pkg.EmbedFiles...)
+		if pkg.ImportPath == "unsafe" {
+			files = append(files, "unsafe.go")
+		}
+		for _, f := range files {
+			if err := copyFile(filepath.Join(pkg.Dir, f), filepath.Join(dst, f)); err != nil {
+				return err
+			}
+		}
+		if len(files) == 0 {
+			// A package with every file excluded still has to exist to be
+			// found, as go/build reports it as having no Go files rather
+			// than as missing.
+			if err := os.MkdirAll(dst, 0o777); err != nil {
+				return err
+			}
+			for _, f := range pkg.IgnoredGoFiles {
+				if err := copyFile(filepath.Join(pkg.Dir, f), filepath.Join(dst, f)); err != nil {
+					return err
+				}
+			}
+		}
+	}
+	for _, p := range sortedKeys(modules) {
+		env.Modules = append(env.Modules, struct {
+			Path string `json:"path"`
+			Dir  string `json:"dir"`
+		}{p, filepath.ToSlash(modules[p])})
+	}
+
+	// The target definitions, link scripts and sources that come with
+	// TinyGo, and clang's own headers, under the names the compiler looks
+	// for them by.
+	tinygoroot := goenv.Get("TINYGOROOT")
+	if err := copyTree(filepath.Join(tinygoroot, "targets"), filepath.Join(out, "tinygo", "targets")); err != nil {
+		return err
+	}
+	// The two files the compiler checks to recognize its root by.
+	for _, f := range []string{"src/runtime/internal/sys/zversion.go", "src/device/arm/arm.go"} {
+		if err := copyFile(filepath.Join(tinygoroot, f), filepath.Join(out, "tinygo", f)); err != nil {
+			return err
+		}
+	}
+	for _, f := range config.ExtraFiles() {
+		if err := copyFile(filepath.Join(tinygoroot, f), filepath.Join(out, "tinygo", f)); err != nil {
+			return err
+		}
+	}
+	if config.Target.LinkerScript != "" {
+		if err := copyFile(filepath.Join(tinygoroot, config.Target.LinkerScript), filepath.Join(out, "tinygo", config.Target.LinkerScript)); err != nil {
+			return err
+		}
+	}
+	resourceDir := goenv.ClangResourceDir(false)
+	if resourceDir == "" {
+		return fmt.Errorf("the clang resource directory is not known; build with -ldflags=-X=github.com/tinygo-org/tinygo/goenv.clangResourceDir=DIR")
+	}
+	if err := copyHeaders(filepath.Join(resourceDir, "include"), filepath.Join(out, "tinygo", "lib", "clang", "include")); err != nil {
+		return err
+	}
+
+	data, err := json.MarshalIndent(env, "", "\t")
+	if err != nil {
+		return err
+	}
+	return os.WriteFile(filepath.Join(out, "env.json"), append(data, '\n'), 0o666)
+}
+
+// toolTags asks the go command which tags it sets for the target besides the
+// GOOS, GOARCH and release ones: the experiments on by default, and the
+// architecture variant.
+func toolTags(config *compileopts.Config) (string, error) {
+	cmd := exec.Command(filepath.Join(goenv.Get("GOROOT"), "bin", "go"), "list", "-f", "{{join context.ToolTags \" \"}}", "runtime")
+	cmd.Env = append(os.Environ(), "GOOS="+config.GOOS(), "GOARCH="+config.GOARCH(), "GOMIPS="+goenv.Get("GOMIPS"), "GOARM="+goenv.Get("GOARM"))
+	cmd.Stderr = os.Stderr
+	output, err := cmd.Output()
+	if err != nil {
+		return "", fmt.Errorf("go list: %w", err)
+	}
+	return strings.TrimSpace(string(output)), nil
+}
+
+// copyFile copies src to dst, following symlinks, creating the directories
+// on the way.
+func copyFile(src, dst string) error {
+	data, err := os.ReadFile(src)
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(dst), 0o777); err != nil {
+		return err
+	}
+	return os.WriteFile(dst, data, 0o666)
+}
+
+// copyTree copies every regular file under src to the same place under dst.
+func copyTree(src, dst string) error {
+	return filepath.Walk(src, func(p string, info os.FileInfo, err error) error {
+		if err != nil {
+			return err
+		}
+		if info.IsDir() {
+			return nil
+		}
+		rel, err := filepath.Rel(src, p)
+		if err != nil {
+			return err
+		}
+		return copyFile(p, filepath.Join(dst, rel))
+	})
+}
+
+// copyHeaders copies the C standard headers from clang's resource
+// directory, which is what C and assembly compiled for a target without a
+// libc include, and leaves the intrinsics for every architecture behind.
+func copyHeaders(src, dst string) error {
+	entries, err := os.ReadDir(src)
+	if err != nil {
+		return err
+	}
+	for _, e := range entries {
+		name := e.Name()
+		if e.IsDir() || path.Ext(name) != ".h" {
+			continue
+		}
+		standard := strings.HasPrefix(name, "std") || strings.HasPrefix(name, "__std")
+		switch name {
+		case "limits.h", "float.h", "inttypes.h", "iso646.h", "tgmath.h", "varargs.h", "unwind.h":
+			standard = true
+		}
+		if !standard {
+			continue
+		}
+		if err := copyFile(filepath.Join(src, name), filepath.Join(dst, name)); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func sortedKeys(m map[string]string) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
diff --git a/cmd/tinygo-wasm/main.go b/cmd/tinygo-wasm/main.go
new file mode 100644
index 0000000..4c3011b
--- /dev/null
+++ b/cmd/tinygo-wasm/main.go
@@ -0,0 +1,104 @@
+// Command tinygo-wasm is the TinyGo compiler as a WebAssembly program: the
+// build command alone, for compiling a program in a browser.
+//
+// It takes the build flags that matter there and the package to build:
+//
+//	tinygo-wasm -target=playstation-yaroze -o prog.elf ./prog
+//
+// Everything the compiler needs, the Go standard library, TinyGo's own
+// source tree and the modules the program imports, has to be in the file
+// system it runs against, since there is no go command to ask.
+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+	"runtime"
+	"strings"
+	"time"
+
+	"github.com/tinygo-org/tinygo/builder"
+	"github.com/tinygo-org/tinygo/compileopts"
+	"github.com/tinygo-org/tinygo/goenv"
+)
+
+func main() {
+	target := flag.String("target", "", "target to build for")
+	output := flag.String("o", "", "output file")
+	opt := flag.String("opt", "z", "optimization level: 0, 1, 2, s, z")
+	tags := flag.String("tags", "", "a space-separated list of extra build tags")
+	work := flag.Bool("work", false, "print the name of the temporary build directory and do not delete it")
+	debug := flag.Bool("debug", false, "keep DWARF debug information, which nothing in the playground reads")
+	printCommands := flag.Bool("x", false, "print commands")
+	printIR := flag.Bool("printir", false, "print LLVM IR")
+	verifyIR := flag.Bool("verifyir", false, "run extra verification steps on LLVM IR")
+	interpTimeout := flag.Duration("interp-timeout", 180*time.Second, "interp optimization pass timeout")
+	flag.Parse()
+	if flag.NArg() != 1 {
+		fmt.Fprintln(os.Stderr, "usage: tinygo-wasm -target=TARGET -o OUTPUT PACKAGE")
+		os.Exit(2)
+	}
+
+	options := &compileopts.Options{
+		GOOS:      goenv.Get("GOOS"),
+		GOARCH:    goenv.Get("GOARCH"),
+		GOARM:     goenv.Get("GOARM"),
+		GOMIPS:    goenv.Get("GOMIPS"),
+		Target:    *target,
+		Opt:       *opt,
+		Work:      *work,
+		PrintIR:   *printIR,
+		VerifyIR:  *verifyIR,
+		Semaphore: make(chan struct{}, 1),
+		Debug:     true,
+		Tags:      strings.Fields(*tags),
+
+		InterpTimeout: *interpTimeout,
+		// There is no git to ask, and the program is not in a repository.
+		BuildVCS: "false",
+	}
+	// DWARF is left out unless asked for: nothing in the playground reads
+	// it, and the IR is a good deal smaller and quicker to handle without.
+	options.Debug = *debug
+	options.SkipDWARF = !*debug
+	if *printCommands {
+		options.PrintCommands = func(cmd string, args ...string) {
+			fmt.Fprintln(os.Stderr, cmd, strings.Join(args, " "))
+		}
+	}
+
+	config, err := builder.NewConfig(options)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "error:", err)
+		os.Exit(1)
+	}
+
+	tmpdir, err := os.MkdirTemp("", "tinygo")
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "error:", err)
+		os.Exit(1)
+	}
+	if !*work {
+		defer os.RemoveAll(tmpdir)
+	} else {
+		fmt.Fprintln(os.Stderr, "WORK="+tmpdir)
+	}
+
+	result, err := builder.Build(flag.Arg(0), *output, tmpdir, config)
+	if os.Getenv("TINYGO_TIMING") != "" {
+		var m runtime.MemStats
+		runtime.ReadMemStats(&m)
+		fmt.Fprintf(os.Stderr, "memstats: NumGC %d, Sys %d MB, HeapSys %d MB, HeapInuse %d MB, TotalAlloc %d MB, Mallocs %d\n", m.NumGC, m.Sys>>20, m.HeapSys>>20, m.HeapInuse>>20, m.TotalAlloc>>20, m.Mallocs)
+	}
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "error:", err)
+		os.Exit(1)
+	}
+	if result.Binary != "" && result.Binary != *output {
+		if err := os.Rename(result.Binary, *output); err != nil {
+			fmt.Fprintln(os.Stderr, "error:", err)
+			os.Exit(1)
+		}
+	}
+}
