+//go:build wasm
+
+package goenv
+
+import (
+	"errors"
+	"os"
+)
+
+// Make sure goEnvVars is fresh. This can be called multiple times, the first
+// time will update all environment variables in goEnvVars.
+//
+// A WebAssembly build of the compiler has no go command to ask, so the values
+// come from the environment it was started with: GOROOT names the directory
+// holding the standard library sources, already merged with TinyGo's, and
+// GOVERSION the Go release they came from, as "go1.27.2". GOPATH may be
+// unset.
+func readGoEnvVars() error {
+	goEnvVarsOnce.Do(func() {
+		goEnvVars.GOROOT = os.Getenv("GOROOT")
+		goEnvVars.GOPATH = os.Getenv("GOPATH")
+		goEnvVars.GOVERSION = os.Getenv("GOVERSION")
+		if goEnvVars.GOROOT == "" || goEnvVars.GOVERSION == "" {
+			goEnvVarsErr = errors.New("GOROOT and GOVERSION must be set in the environment")
+		}
+	})
+	return goEnvVarsErr
+}
