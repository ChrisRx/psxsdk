+//go:build wasm
+
+package cgo
+
+import (
+	"go/ast"
+	"go/scanner"
+	"go/token"
+)
+
+// Process would parse the `import "C"` fragments of files with libclang and
+// add the declarations they need to the AST. A WebAssembly build of the
+// compiler leaves libclang out, which takes a good part of clang with it,
+// and TinyGo's cgo passes structs in a way wasm's C ABI does not accept
+// anyway, so packages that use cgo cannot be built by it.
+func Process(files []*ast.File, dir, importPath string, fset *token.FileSet, cflags []string, goos string) ([]*ast.File, []string, []string, []string, map[string][]byte, []error) {
+	var pos token.Position
+	if len(files) > 0 {
+		pos = fset.Position(files[0].Package)
+	}
+	return nil, nil, nil, nil, nil, []error{scanner.Error{Pos: pos, Msg: "cgo is not supported by this build of the compiler"}}
+}
