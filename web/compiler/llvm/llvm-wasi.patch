+    // The same goes for the fall-through when the candidate is its first
+    // instruction.
+    if (ElseInstr == &Candidate)
+      ElseInstr = firstExecutedInstr(*Candidate.getParent(), &Candidate);
+    if (!ElseInstr)
+      return true;
+    Exposed |= !IsSafe(*ElseInstr, Candidate);
+  }
+
+  return Exposed;
+}
